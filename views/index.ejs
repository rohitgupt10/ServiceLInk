<link
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
  rel="stylesheet"
/>
<main>
  <section id="hero" class="home-hero py-16 md:py-24 lg:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="hero-kicker">Local help, made human</p>
      <h1 class="hero-title mt-5 text-slate-900">
        Find the right help for <span>real life.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
        Discover trusted people in your community for the jobs that matter, from
        a quick repair to a skill worth sharing.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="/services"
          class="primary-action inline-flex items-center justify-center rounded-md px-6 py-3 text-sm font-bold"
        >
          Explore services <span class="ml-3">&#8594;</span>
        </a>
        <a
          href="/advanced-search"
          class="secondary-action inline-flex items-center justify-center rounded-md px-6 py-3 text-sm font-bold"
        >
          Advanced search
        </a>
      </div>
      <div class="hero-search mt-10 w-full max-w-2xl rounded-lg p-2">
        <div class="relative flex items-center">
          <input
            type="text"
            id="search-input"
            placeholder="What are you looking for?"
            class="w-full rounded-md border-0 bg-transparent px-4 py-3 text-slate-700 placeholder-slate-400"
          />
          <button
            type="button"
            id="search-button"
            class="primary-action flex shrink-0 items-center rounded-md px-5 py-3 text-sm font-bold"
          >
            <span>Search</span>
          </button>
        </div>
      </div>
    </div>
  </section>
  <!-- Popular Services Section -->
  <section id="popular-services" class="bg-white py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
        <div>
          <p class="hero-kicker">Start here</p>
          <h2
            class="font-display mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl"
          >
            Popular Services
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-6 text-slate-500">
          A few of the ways your local community can lend a hand.
        </p>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        <a
          href="/services?category=Tutoring"
          class="service-tile group rounded-lg bg-slate-50 p-5 text-left"
        >
          <i class="fas fa-book-open mb-7 text-2xl text-orange-600"></i>
          <span
            class="block text-sm font-bold text-slate-800 group-hover:text-orange-700"
            >Tutoring</span
          >
        </a>
        <a
          href="/services?category=Furniture+Assembly"
          class="service-tile group rounded-lg bg-slate-50 p-5 text-left"
        >
          <i class="fas fa-chair mb-7 text-2xl text-orange-600"></i>
          <span
            class="block text-sm font-bold text-slate-800 group-hover:text-orange-700"
            >Furniture Assembly</span
          >
        </a>
        <a
          href="/services?category=Moving"
          class="service-tile group rounded-lg bg-slate-50 p-5 text-left"
        >
          <i class="fas fa-truck-moving mb-7 text-2xl text-orange-600"></i>
          <span
            class="block text-sm font-bold text-slate-800 group-hover:text-orange-700"
            >Help Moving</span
          >
        </a>
        <a
          href="/services?category=Cleaning"
          class="service-tile group rounded-lg bg-slate-50 p-5 text-left"
        >
          <i class="fas fa-broom mb-7 text-2xl text-orange-600"></i>
          <span
            class="block text-sm font-bold text-slate-800 group-hover:text-orange-700"
            >Cleaning</span
          >
        </a>
        <a
          href="/services?category=Tech+Support"
          class="service-tile group rounded-lg bg-slate-50 p-5 text-left"
        >
          <i class="fas fa-laptop-code mb-7 text-2xl text-orange-600"></i>
          <span
            class="block text-sm font-bold text-slate-800 group-hover:text-orange-700"
            >Tech Support</span
          >
        </a>
        <a
          href="/services?category=Gardening"
          class="service-tile group rounded-lg bg-slate-50 p-5 text-left"
        >
          <i class="fas fa-leaf mb-7 text-2xl text-orange-600"></i>
          <span
            class="block text-sm font-bold text-slate-800 group-hover:text-orange-700"
            >Gardening</span
          >
        </a>
        <a
          href="/services?category=Personal+Assistant"
          class="service-tile group rounded-lg bg-slate-50 p-5 text-left"
        >
          <i class="fas fa-clipboard-list mb-7 text-2xl text-orange-600"></i>
          <span
            class="block text-sm font-bold text-slate-800 group-hover:text-orange-700"
            >Personal Assistant</span
          >
        </a>
        <a
          href="/services?category=Delivery"
          class="service-tile group rounded-lg bg-slate-50 p-5 text-left"
        >
          <i class="fas fa-shipping-fast mb-7 text-2xl text-orange-600"></i>
          <span
            class="block text-sm font-bold text-slate-800 group-hover:text-orange-700"
            >Delivery</span
          >
        </a>
      </div>
    </div>
  </section>
  <!-- How It Works Section -->
  <section
    id="how-it-works"
    class="border-t border-slate-200 bg-slate-50 py-16 md:py-24"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2
        class="font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl"
      >
        How It Works
      </h2>
      <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">
        Connecting local service seekers and givers is simple.
      </p>
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Step 1 -->
        <div
          class="step-card flex flex-col items-center rounded-lg border border-slate-200 bg-white p-6 shadow-sm transition-transform hover:-translate-y-1 hover:shadow-md"
        >
          <div
            class="mb-6 inline-flex items-center justify-center rounded-full bg-orange-100 p-4 text-orange-700"
          >
            <span class="text-3xl">🔍</span>
          </div>
          <h3 class="text-xl font-semibold text-slate-800">1. Find or Post</h3>
          <p class="mt-3 text-slate-600 text-center">
            Are you looking for help? Search for services. Do you offer skills?
            Create your listing.
          </p>
        </div>
        <!-- Step 2 -->
        <div
          class="step-card flex flex-col items-center rounded-lg border border-slate-200 bg-white p-6 shadow-sm transition-transform hover:-translate-y-1 hover:shadow-md"
        >
          <div
            class="mb-6 inline-flex items-center justify-center rounded-full bg-emerald-100 p-4 text-emerald-700"
          >
            <span class="text-3xl">🤝</span>
          </div>
          <h3 class="text-xl font-semibold text-slate-800">
            2. Connect Directly
          </h3>
          <p class="mt-3 text-slate-600 text-center">
            View profiles, compare offerings, and contact providers directly to
            discuss your needs.
          </p>
        </div>
        <!-- Step 3 -->
        <div
          class="step-card flex flex-col items-center rounded-lg border border-slate-200 bg-white p-6 shadow-sm transition-transform hover:-translate-y-1 hover:shadow-md"
        >
          <div
            class="mb-6 inline-flex items-center justify-center rounded-full bg-sky-100 p-4 text-sky-700"
          >
            <span class="text-3xl">✨</span>
          </div>
          <h3 class="text-xl font-semibold text-slate-800">
            3. Get Things Done
          </h3>
          <p class="mt-3 text-slate-600 text-center">
            Engage the right professional, complete your tasks, and empower your
            local community.
          </p>
        </div>
      </div>
      <p class="mt-3 text-slate-600 text-center">
        Join our community as either a Service Provider or Service Seeker –
        whichever matches your needs.
      </p>
    </div>
  </section>
  <!-- Call to Action / Join Section -->
  <section id="join-us" class="bg-slate-50 py-10 text-white md:py-12">
    <div
      class="join-band mx-auto flex max-w-6xl flex-col gap-8 px-6 py-8 sm:px-8 md:flex-row md:items-center md:justify-between md:gap-12"
    >
      <div>
        <p class="join-label">Your next step</p>
        <h2 class="join-title mt-3">Ready to connect?</h2>
        <p class="join-copy mt-3">
          Find reliable help nearby or share the skills your community needs.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a
          href="/auth/register"
          class="join-action join-action-primary inline-flex items-center justify-center"
        >
          Find a service <span class="ml-2">&#8594;</span>
        </a>
        <a
          href="/auth/register"
          class="join-action inline-flex items-center justify-center"
        >
          Offer your skills
        </a>
      </div>
    </div>
  </section>
</main>
<script>
  // Added JavaScript for search functionality
  document
    .getElementById("search-button")
    .addEventListener("click", function () {
      const query = document.getElementById("search-input").value.trim();
      if (query) {
        window.location.href = `/services?q=${encodeURIComponent(query)}`;
      }
    });
  // Optional: Allow Enter key to trigger search
  document
    .getElementById("search-input")
    .addEventListener("keypress", function (e) {
      if (e.key === "Enter") {
        const query = this.value.trim();
        if (query) {
          window.location.href = `/services?q=${encodeURIComponent(query)}`;
        }
      }
    });
</script>
