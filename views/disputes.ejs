<%- include('partials/header') %>

<div class="custom-container py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2">Disputes & Complaints</h1>
    <p class="text-gray-600">Manage and resolve booking disputes</p>
  </div>

  <!-- Tabs -->
  <div class="flex gap-4 mb-6 border-b">
    <button
      class="tab-btn active py-3 px-4 border-b-2 border-indigo-600 font-semibold"
      data-tab="my-disputes"
    >
      My Disputes
    </button>
    <button
      class="tab-btn py-3 px-4 border-b-2 border-transparent font-semibold hover:border-gray-300"
      data-tab="new-dispute"
    >
      File New Dispute
    </button>
  </div>

  <!-- Tab Content -->
  <div class="tab-content" id="my-disputes-tab">
    <div id="disputesList" class="space-y-4">
      <p class="text-gray-500">Loading disputes...</p>
    </div>
  </div>

  <div class="tab-content hidden" id="new-dispute-tab">
    <div class="bg-white rounded-lg shadow-md p-6 max-w-2xl">
      <h3 class="text-xl font-bold mb-4">File a New Dispute</h3>

      <form id="newDisputeForm" class="space-y-4">
        <div>
          <label class="block font-semibold mb-2">Select Booking</label>
          <select
            name="bookingId"
            class="w-full border rounded px-3 py-2"
            required
          >
            <option value="">-- Choose a booking --</option>
            <!-- Populate with user's bookings -->
          </select>
          <small class="text-gray-600"
            >Only completed or cancelled bookings can have disputes filed</small
          >
        </div>

        <div>
          <label class="block font-semibold mb-2">Dispute Title</label>
          <input
            type="text"
            name="title"
            placeholder="Brief summary of the issue"
            class="w-full border rounded px-3 py-2"
            required
          />
        </div>

        <div>
          <label class="block font-semibold mb-2">Description</label>
          <textarea
            name="description"
            placeholder="Describe the issue in detail"
            rows="5"
            class="w-full border rounded px-3 py-2"
            required
          ></textarea>
        </div>

        <div>
          <label class="block font-semibold mb-2">Category</label>
          <select name="category" class="w-full border rounded px-3 py-2">
            <option value="">Select a category</option>
            <option value="quality">Quality of Service</option>
            <option value="incomplete">Incomplete Service</option>
            <option value="payment">Payment Issue</option>
            <option value="behavior">Provider Behavior</option>
            <option value="other">Other</option>
          </select>
        </div>

        <button
          type="submit"
          class="w-full bg-red-600 text-white py-2 rounded hover:bg-red-700 font-semibold"
        >
          File Dispute
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  // Tab switching
  document.querySelectorAll(".tab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".tab-btn").forEach((b) => {
        b.classList.remove("border-indigo-600");
        b.classList.add("border-transparent");
      });
      btn.classList.remove("border-transparent");
      btn.classList.add("border-indigo-600");

      document
        .querySelectorAll(".tab-content")
        .forEach((c) => c.classList.add("hidden"));
      document
        .getElementById(btn.dataset.tab + "-tab")
        .classList.remove("hidden");
    });
  });

  // Load disputes
  async function loadDisputes() {
    try {
      const res = await fetch("/api/disputes/my-disputes");
      const data = await res.json();
      const container = document.getElementById("disputesList");

      if (data.disputes && data.disputes.length > 0) {
        container.innerHTML = data.disputes
          .map(
            (dispute) => `
        <div class="bg-white rounded-lg shadow-md p-4 border-l-4 border-${dispute.status === "open" ? "red" : dispute.status === "resolved" ? "green" : "yellow"}-500">
          <div class="flex justify-between items-start mb-2">
            <div>
              <h4 class="font-bold text-lg">${dispute.title}</h4>
              <p class="text-sm text-gray-600">Booking: ${dispute.booking._id}</p>
            </div>
            <span class="bg-${dispute.status === "open" ? "red" : dispute.status === "resolved" ? "green" : "yellow"}-100 text-${dispute.status === "open" ? "red" : dispute.status === "resolved" ? "green" : "yellow"}-800 px-3 py-1 rounded text-sm font-semibold">
              ${dispute.status.toUpperCase()}
            </span>
          </div>
          <p class="text-gray-700 mb-3">${dispute.description}</p>
          ${dispute.resolutionDetails ? `<p class="text-sm text-gray-600"><strong>Resolution:</strong> ${dispute.resolutionDetails}</p>` : ""}
          <p class="text-xs text-gray-500 mt-2">Filed: ${new Date(dispute.createdAt).toLocaleDateString()}</p>
        </div>
      `,
          )
          .join("");
      } else {
        container.innerHTML =
          '<p class="text-gray-500">No disputes filed yet.</p>';
      }
    } catch (err) {
      console.error(err);
      document.getElementById("disputesList").innerHTML =
        '<p class="text-red-500">Error loading disputes</p>';
    }
  }

  // Load user's bookings for dispute filing
  async function loadUserBookings() {
    try {
      const res = await fetch("/profile/bookings/history");
      const data = await res.json();
      const select = document.querySelector('select[name="bookingId"]');

      if (data.bookings && data.bookings.length > 0) {
        data.bookings.forEach((booking) => {
          const option = document.createElement("option");
          option.value = booking._id;
          option.textContent = `${booking.service.title} - ${new Date(booking.date).toLocaleDateString()}`;
          select.appendChild(option);
        });
      }
    } catch (err) {
      console.error(err);
    }
  }

  // Handle dispute form submission
  document
    .getElementById("newDisputeForm")
    ?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);

      try {
        const res = await fetch("/api/disputes/create", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            bookingId: formData.get("bookingId"),
            title: formData.get("title"),
            description: formData.get("description"),
          }),
        });

        if (res.ok) {
          alert("Dispute filed successfully");
          e.target.reset();
          loadDisputes();
        }
      } catch (err) {
        console.error(err);
        alert("Error filing dispute");
      }
    });

  loadDisputes();
  loadUserBookings();
</script>

<%- include('partials/footer') %>
